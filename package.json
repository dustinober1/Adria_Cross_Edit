{
  "name": "adria_cross_edit",
  "version": "2.0.0",
  "private": true,
  "description": "Static, SEO-first Adria Cross Edit website built with Next.js App Router.",
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/validate-blog-content.mjs && node scripts/generate-search-index.mjs",
    "build": "npm run lint && npm run typecheck && next build && node scripts/verify-static-seo.mjs",
    "start": "serve out",
    "preview": "serve out",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "seo:audit": "node scripts/verify-static-seo.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dustinober1/Adria_Cross_Edit.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/dustinober1/Adria_Cross_Edit/issues"
  },
  "homepage": "https://github.com/dustinober1/Adria_Cross_Edit#readme",
  "dependencies": {
    "next": "^16.2.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.17",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "cheerio": "^1.1.2",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.2.4",
    "serve": "^14.2.5",
    "tailwindcss": "^4.1.17",
    "typescript": "^5.9.3",
    "vitest": "^4.0.8"
  }
